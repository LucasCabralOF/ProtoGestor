{
  "name": "protogestor-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@protogestor/web",
    "dev:mobile": "turbo run dev --filter=@protogestor/mobile",
    "build": "turbo run build",
    "check": "turbo run check",
    "check:fix": "biome check --write",
    "test:unit": "turbo run test:unit",
    "test:e2e": "npm --workspace=@protogestor/web run test:e2e",
    "db:generate": "npm --workspace=@protogestor/web run db:generate",
    "db:reset": "npm --workspace=@protogestor/web run db:reset",
    "db:push": "npm --workspace=@protogestor/web run db:push",
    "db:studio": "npm --workspace=@protogestor/web run db:studio"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  }
}
