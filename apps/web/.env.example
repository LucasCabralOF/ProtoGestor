# ==============================================================================
# PROTO GESTOR - GUIA DE VARIÁVEIS DE AMBIENTE (LOCAL & VERCEL)
# ==============================================================================

# ==============================================================================
# SEÇÃO A: OBRIGATÓRIAS NA VERCEL (apps/web)
# No painel da Vercel: Project Settings -> Environment Variables
# ==============================================================================

# 1. BANCO DE DADOS (PostgreSQL em Nuvem)
# O banco local (localhost/Docker) NÃO funciona na Vercel.
# Utilize um PostgreSQL gerenciado (ex: Neon.tech, Supabase, Vercel Postgres, AWS RDS).
# Dica: em ambiente serverless, adicione '?sslmode=require'.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST_EM_NUVEM:5432/NOME_DO_BANCO?sslmode=require"

# 2. SEGREDO DE CRIPTOGRAFIA (Better Auth)
# Chave aleatória e estável de 32+ caracteres para assinatura de cookies e tokens JWT.
# Gere um novo com: openssl rand -hex 32
BETTER_AUTH_SECRET="gerar-uma-chave-longa-e-segura-de-32-caracteres"

# 3. URL DE PRODUÇÃO DA VERCEL (Better Auth)
# URL pública do deploy da Vercel com https:// (sem barra no final)
# Exemplo padrão: https://protogestor.vercel.app
# Exemplo domínio próprio: https://app.meudominio.com.br
BETTER_AUTH_URL="https://seu-projeto.vercel.app"


# ==============================================================================
# SEÇÃO B: DESENVOLVIMENTO LOCAL (.env local na sua máquina)
# ==============================================================================
# DATABASE_URL="postgresql://postgres:13454460@localhost:5432/app?schema=public"
# BETTER_AUTH_SECRET="secret-development-key-gestor-protogestor-123456789"
# BETTER_AUTH_URL="http://localhost:3001"
